{
	"name": "svelte-latest",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest",
		"test:smoke": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.67.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/three": "^0.186.0",
		"@webgpu/types": "^0.1.74",
		"autoprefixer": "^10.6.2",
		"bits-ui": "^0.22.0",
		"clsx": "^2.1.1",
		"dotenv": "^18.0.9",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sharp": "^0.35.5",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-merge": "^2.6.1",
		"tailwind-variants": "^0.3.1",
		"tailwindcss": "^3.4.19",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vite-plugin-devtools-json": "^1.1.2",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@notionhq/client": "^2.3.0",
		"@sveltejs/adapter-vercel": "^6.3.5",
		"@vercel/analytics": "^2.0.1",
		"glsl_math": "^1.0.0",
		"highlight.js": "^11.12.0",
		"mathjs": "^15.2.0",
		"mode-watcher": "^1.1.0",
		"svelte-gestures": "~5.1.4",
		"svhighlight": "^0.7.1",
		"three": "^0.186.1"
	},
	"engines": {
		"node": "24.x"
	},
	"allowScripts": {
		"esbuild": false,
		"fsevents": false
	},
	"overrides": {
		"@vercel/nft": {
			"glob": "14.0.3"
		},
		"minimatch@>=10 <11": "11.0.4",
		"@sveltejs/kit": {
			"cookie": "0.7.2"
		}
	}
}
